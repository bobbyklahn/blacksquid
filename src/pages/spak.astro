---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteAdd from '../components/QuoteAdd.jsx';
import QuoteBasket from '../components/QuoteBasket.jsx';
import { audFmt } from '../lib/format.js';

const items = (await getCollection('bottles')).sort((a, b) => a.data.order - b.data.order);
const bottles = items.filter((i) => i.data.category === 'bottle');
const closures = items.filter((i) => i.data.category === 'closure');
---
<BaseLayout
  title="SPAK — Spirit Bottles & Closures, Wholesale — Black Squid Distillery"
  description="Quality spirit bottles and closures for trade: TAHO, TSC and Super Flint glass in 200–700ml, screw cap and cork mouth, with matching closures. Wholesale quantities, quoted by email."
  noCart
>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">SPAK · Trade supply</p>
      <h1>Bottles &amp; closures,<br />by the pallet or the box.</h1>
      <p class="muted" style="max-width: 60ch;">
        The same glass we bottle our own spirits in. TAHO, TSC and Super Flint bottles from 200ml to
        700ml, screw cap or cork mouth, with matching closures. Wholesale only — build your list,
        send it as one enquiry, and we&rsquo;ll come back with quantity pricing and freight.
      </p>
      <p class="depot muted">
        Warehouse: 22 Priority Court, Edinburgh North, South Australia 5113 ·
        <a href="mailto:admin@blacksquiddistillery.com.au" style="color: var(--squid);">admin@blacksquiddistillery.com.au</a>
      </p>
    </div>
  </header>

  <div class="wrap spak-grid pad-s">
    <div>
      <section id="bottles">
        <h2 class="section-h" style="font-size: clamp(1.5rem, 3vw, 2.1rem);">Bottles</h2>
        <div class="sku-list">
          {bottles.map((b) => (
            <div class="sku reveal">
              {b.data.image && (
                <div class="sku-img"><img src={b.data.image} alt={b.data.title} loading="lazy" width="100" height="125" /></div>
              )}
              <div class="sku-info">
                <h3>{b.data.title}</h3>
                <p class="sku-price">
                  {b.data.priceFrom && <span class="from">from</span>} {audFmt(b.data.price)} <span class="ea">ea</span>
                  {b.data.priceFrom && <span class="tiers"> · quantity breaks apply</span>}
                </p>
              </div>
              <QuoteAdd client:visible slug={b.id} title={b.data.title} price={b.data.price} priceFrom={b.data.priceFrom} />
            </div>
          ))}
        </div>
      </section>

      <section id="closures" style="margin-top: 56px;">
        <h2 class="section-h" style="font-size: clamp(1.5rem, 3vw, 2.1rem);">Closures</h2>
        <div class="sku-list">
          {closures.map((b) => (
            <div class="sku reveal">
              {b.data.image && (
                <div class="sku-img"><img src={b.data.image} alt={b.data.title} loading="lazy" width="100" height="125" /></div>
              )}
              <div class="sku-info">
                <h3>{b.data.title}</h3>
                <p class="sku-price">{audFmt(b.data.price)} <span class="ea">ea</span></p>
              </div>
              <QuoteAdd client:visible slug={b.id} title={b.data.title} price={b.data.price} priceFrom={b.data.priceFrom} />
            </div>
          ))}
        </div>
      </section>
    </div>

    <QuoteBasket client:load />
  </div>
</BaseLayout>

<style>
  .page-head { padding: clamp(140px, 22vh, 210px) 0 clamp(26px, 4vh, 48px); }
  .page-head h1 { font-size: clamp(2.2rem, 6vw, 4.2rem); margin: 12px 0 18px; }
  .depot { margin-top: 22px; font-size: 0.82rem; }
  .spak-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(30px, 4vw, 60px); align-items: start; }
  @media (max-width: 920px) { .spak-grid { grid-template-columns: 1fr; } }
  .sku-list { border-top: 1px solid var(--line); }
  .sku {
    display: flex; align-items: center; justify-content: space-between; gap: 18px;
    padding: 14px 4px; border-bottom: 1px solid var(--line);
  }
  @media (max-width: 560px) { .sku { flex-wrap: wrap; } }
  .sku-img {
    flex: 0 0 64px; width: 64px; height: 80px; border: 1px solid var(--line);
    border-radius: 2px; background: #f4f2ee; overflow: hidden; display: grid; place-items: center;
  }
  .sku-img img { width: 100%; height: 100%; object-fit: contain; padding: 4px; }
  .sku-info { flex: 1; min-width: 180px; }
  .sku h3 { font-size: 1.02rem; font-weight: 480; }
  .sku-price { color: var(--muted); font-size: 0.84rem; margin-top: 3px; }
  .sku-price .from { font-style: italic; }
  .sku-price .ea { font-size: 0.72rem; }
  .sku-price .tiers { font-size: 0.74rem; color: var(--brass); }
</style>
