---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Black Squid Distillery" description="This page swam off.">
  <section class="wrap center" style="padding: clamp(180px, 30vh, 280px) 28px 140px;">
    <p class="eyebrow">404</p>
    <h1 style="font-size: clamp(2.4rem, 6vw, 4.5rem); margin: 14px 0 18px;">Lost in the ink.</h1>
    <p class="muted" style="max-width: 44ch; margin: 0 auto 36px;">
      This page has swum off somewhere darker. Try the gins — they&rsquo;re easier to find.
    </p>
    <a class="btn ghost" href="/">Back to shore</a>
  </section>
</BaseLayout>
