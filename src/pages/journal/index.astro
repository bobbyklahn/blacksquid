---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('journal')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d) => d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout
  title="Journal — Black Squid Distillery"
  description="News from the still-house: releases, experiments and life in the Barossa Valley."
>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Journal</p>
      <h1>From the still-house.</h1>
    </div>
  </header>

  <section class="pad-s">
    <div class="wrap">
      {posts.length === 0 && <p class="muted">Nothing inked yet — check back soon.</p>}
      <div class="posts">
        {posts.map((p) => (
          <a class="post reveal" href={`/journal/${p.id}`}>
            <p class="pdate">{fmt(p.data.date)}</p>
            <h2>{p.data.title}</h2>
            {p.data.excerpt && <p class="muted">{p.data.excerpt}</p>}
            <span class="more">Read →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .posts { display: grid; gap: 24px; max-width: 760px; }
  .post { border: 1px solid var(--line-strong); background: var(--plate); padding: 30px 32px; border-radius: 3px; transition: border-color 0.4s, transform 0.45s var(--ease), box-shadow 0.45s var(--ease); }
  .post:hover { border-color: var(--cobalt); transform: translateY(-2px); box-shadow: 0 18px 36px -28px rgba(20, 24, 15, 0.5); }
  .pdate { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--cobalt); margin-bottom: 8px; }
  .post h2 { font-size: 1.6rem; margin-bottom: 8px; font-weight: 540; }
  .more { display: inline-block; margin-top: 14px; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cobalt); }
</style>
