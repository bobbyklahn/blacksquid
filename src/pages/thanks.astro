---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Order received — Black Squid Distillery" description="Thank you — your order is in.">
  <section class="wrap center" style="padding: clamp(180px, 30vh, 280px) 28px 140px;">
    <p class="eyebrow blush">Order received</p>
    <h1 style="font-size: clamp(2.4rem, 6vw, 4.5rem); margin: 14px 0 18px;">The ink is signed.</h1>
    <p class="muted" style="max-width: 48ch; margin: 0 auto 36px;">
      Thank you — your payment went through and a receipt from Stripe is on its way to your inbox.
      We&rsquo;ll pack your bottles and be in touch with delivery details. Remember: an adult
      signature is required on delivery.
    </p>
    <a class="btn ghost" href="/gins">Back to the gins</a>
  </section>
</BaseLayout>
