---
import BaseLayout from '../layouts/BaseLayout.astro';
const EMAIL = 'admin@blacksquiddistillery.com.au';

const steps = [
  {
    n: '01',
    title: 'Develop',
    body: 'We start on Tinny, our 50-litre trial still. Your brief — style, botanicals, strength, price point — becomes real test batches you can taste, compare and refine. New brand or line extension, this is where it takes shape.',
  },
  {
    n: '02',
    title: 'Refine',
    body: 'We iterate the recipe with you: high-grade neutral spirit, fresh fruit and botanicals sourced from across the world, and Barossa Valley rainwater. You sign off on the liquid before anything scales.',
  },
  {
    n: '03',
    title: 'Scale',
    body: 'Production moves up through Lucy and Katrina to Bertha, our 3,000-litre still, with blending options from 500 litres to 600,000 litres. The recipe you approved is the recipe that ships.',
  },
  {
    n: '04',
    title: 'Bottle & launch',
    body: 'Through SPAK, our bottle and closure supply arm, we bottle in TAHO, TSC or Super Flint glass with your choice of closure — and can assist with label and product design. MOQ from 1,000 bottles to full container loads.',
  },
];
---
<BaseLayout
  title="Custom & Contract Distilling — Black Squid Distillery, Barossa Valley"
  description="Contract distilling from the Barossa Valley: gin and vodka developed, distilled, blended and bottled for your brand. Trial batches on our 50L still, scale to 600,000L blending, MOQ from 1,000 bottles."
>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Custom &amp; Contract Distilling</p>
      <h1>Your brand.<br />Our stills.</h1>
      <p class="muted" style="max-width: 62ch;">
        Black Squid is an innovative craft distillation complex in the Barossa Valley — and our
        four stills don&rsquo;t only pour for us. We develop and produce top-quality spirits for
        other brands, from first trial batch to full container loads, using high-grade alcohol,
        fresh fruits and botanicals from all across the world.
      </p>
      <div class="stats">
        <div><span class="k">4</span><span class="l">Distilling units</span></div>
        <div><span class="k">500–600kL</span><span class="l">Blending range</span></div>
        <div><span class="k">1,000+</span><span class="l">Bottle MOQ</span></div>
        <div><span class="k">FCL</span><span class="l">Up to container loads</span></div>
      </div>
    </div>
  </header>

  <section class="pad-s">
    <div class="wrap">
      <p class="eyebrow brass">What we distil</p>
      <h2 class="section-h">Gin &amp; vodka, to your spec.</h2>
      <div class="spirit-cols">
        <div class="spirit-col reveal">
          <h3>Gin</h3>
          <p class="muted">
            Standard and contemporary gins, classic London Dry, Old Tom, our signature
            Barossa Shiraz Gin style, and flavoured gins built around your brief — colour-changing
            botanicals included. If you&rsquo;ve tasted it in our range, we can build a version that&rsquo;s yours.
          </p>
        </div>
        <div class="spirit-col reveal">
          <h3>Vodka</h3>
          <p class="muted">
            Traditional clean-profile vodkas and flavoured vodkas, produced from high-grade
            spirit and finished with pure Barossa Valley rainwater. Smooth enough to carry your
            label, consistent enough to reorder.
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider-ink" />

  <section class="pad-s">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2 class="section-h">From 50 litres to 600,000.</h2>
      <div class="steps">
        {steps.map((s) => (
          <article class="step reveal">
            <span class="step-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.body}</p>
          </article>
        ))}
      </div>
      <p class="muted reveal" style="margin-top: 36px; max-width: 60ch;">
        We assist small, new brand owners starting their own boutique label as well as
        established brands, retailers and chain stores developing private-label ranges.
        One partner from liquid to label to bottle.
      </p>
    </div>
  </section>

  <hr class="divider-ink" />

  <!-- ============ ENQUIRY ============ -->
  <section class="pad-s" id="enquire">
    <div class="wrap twocol" style="align-items: start;">
      <div>
        <p class="eyebrow blush">Start the conversation</p>
        <h2 class="section-h">Tell us about your brand.</h2>
        <p class="muted body">
          A few details about what you want to make and at what volume, and we&rsquo;ll come back
          with feasibility, timing and pricing. No brief is too early — half our conversations
          start with &ldquo;we&rsquo;ve got an idea.&rdquo;
        </p>
        <p class="muted body" style="margin-top: 14px;">
          Prefer email? <a href={`mailto:${EMAIL}?subject=Contract%20distilling%20enquiry`} style="color: var(--squid); text-decoration: underline;">{EMAIL}</a>
        </p>
      </div>

      <form class="cd-form" id="cd-form">
        <label for="cd-name">Name</label>
        <input id="cd-name" required placeholder="Jane Distiller" />
        <label for="cd-company">Company / brand</label>
        <input id="cd-company" placeholder="Vale Spirits Co." />
        <label for="cd-email">Email</label>
        <input id="cd-email" type="email" required placeholder="you@brand.com.au" />
        <label for="cd-phone">Phone</label>
        <input id="cd-phone" placeholder="04xx xxx xxx" />

        <label>Products of interest</label>
        <div class="cd-checks">
          <label class="chk"><input type="checkbox" id="cd-gin" checked /> Gin</label>
          <label class="chk"><input type="checkbox" id="cd-vodka" /> Vodka</label>
        </div>

        <label for="cd-vol">Volume</label>
        <select id="cd-vol">
          <option>500 – 2,000L</option>
          <option>2,000 – 10,000L</option>
          <option>10,000L plus</option>
          <option>Not sure yet</option>
        </select>

        <label for="cd-msg">Your brief</label>
        <textarea id="cd-msg" rows="4" placeholder="Style, flavour direction, target price, timing…"></textarea>

        <button class="btn solid" type="submit" style="width: 100%; margin-top: 20px; padding: 15px;">
          Send enquiry
        </button>
        <p class="muted" style="font-size: 0.7rem; margin-top: 10px;">Opens in your email app, addressed to {EMAIL}.</p>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 50px; border-top: 1px solid var(--line); padding-top: 32px; }
  @media (max-width: 720px) { .stats { grid-template-columns: repeat(2, 1fr); } }
  .stats .k { font-family: var(--serif); font-size: 1.8rem; color: var(--squid); display: block; }
  .stats .l { font-size: 0.66rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); margin-top: 6px; display: block; }

  .spirit-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-top: 30px; }
  @media (max-width: 760px) { .spirit-cols { grid-template-columns: 1fr; } }
  .spirit-col { border: 1px solid var(--line); background: var(--ink-2); border-radius: 3px; padding: 34px 32px; }
  .spirit-col h3 { font-size: 1.7rem; margin-bottom: 10px; }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 26px; margin-top: 36px; }
  @media (max-width: 980px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 580px) { .steps { grid-template-columns: 1fr; } }
  .step { border-top: 1px solid var(--line-strong); padding-top: 18px; }
  .step-n { font-family: var(--serif); color: var(--brass); font-size: 0.9rem; letter-spacing: 0.2em; }
  .step h3 { font-size: 1.25rem; margin: 8px 0 8px; }
  .step p { font-size: 0.88rem; }

  .cd-form { border: 1px solid var(--line); background: var(--ink-2); padding: 36px 32px; border-radius: 3px; }
  .cd-checks { display: flex; gap: 24px; }
  .cd-checks .chk { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 0.9rem; letter-spacing: normal; text-transform: none; color: var(--paper); }
  .cd-checks input { width: auto; }
</style>

<script>
  const f = document.getElementById('cd-form');
  f?.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = (id) => document.getElementById(id)?.value?.trim() ?? '';
    const c = (id) => document.getElementById(id)?.checked;
    const products = [c('cd-gin') && 'Gin', c('cd-vodka') && 'Vodka'].filter(Boolean).join(' + ') || '—';
    const body = [
      'Hello Black Squid,',
      '',
      'Contract distilling enquiry:',
      '',
      `Products of interest: ${products}`,
      `Volume: ${v('cd-vol') || document.getElementById('cd-vol').value}`,
      `Brief: ${v('cd-msg') || '—'}`,
      '',
      `Name: ${v('cd-name')}`,
      v('cd-company') ? `Company: ${v('cd-company')}` : null,
      `Email: ${v('cd-email')}`,
      v('cd-phone') ? `Phone: ${v('cd-phone')}` : null,
    ].filter((l) => l !== null).join('\n');
    location.href = `mailto:admin@blacksquiddistillery.com.au?subject=${encodeURIComponent('Contract distilling enquiry — ' + (v('cd-company') || v('cd-name')))}&body=${encodeURIComponent(body)}`;
  });
</script>
