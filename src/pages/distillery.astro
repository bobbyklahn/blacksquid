---
import BaseLayout from '../layouts/BaseLayout.astro';
import StillMark from '../components/StillMark.astro';

const stills = [
  {
    name: 'Tinny',
    size: '50L',
    build: 'Trial still',
    temperament: 'The test pilot',
    note: 'Every new recipe starts inside Tinny. Fifty litres of pure experimentation \u2014 trial batches, wild botanicals, the ideas that become next year\u2019s releases.',
    variant: 'tinny',
  },
  {
    name: 'Lucy',
    size: '300L',
    build: 'Copper pot still',
    temperament: 'The hard-working beauty',
    note: 'Lucy carries the everyday weight of the distillery — batch after batch, gin after gin, without complaint. Most of what you pour started inside her.',
    variant: 'lucy',
  },
  {
    name: 'Katrina',
    size: '200L',
    build: 'Full copper still',
    temperament: 'The purist',
    note: 'Katrina is full copper, top to bottom — the still we turn to when a spirit needs the softest, cleanest conversation with the metal.',
    variant: 'katrina',
  },
  {
    name: 'Bertha',
    size: '3000L',
    build: 'Copper still',
    temperament: 'The new arrival. She is big.',
    note: 'Bertha has just arrived, and she is exactly as advertised. Three thousand litres of ambition — the future of Black Squid runs through her.',
    variant: 'bertha',
  },
];
---
<BaseLayout
  title="The Distillery & The Stills — Black Squid Distillery, Barossa Valley"
  description="Black Squid Distillery sits in the heart of the Barossa Valley among the world's famous wineries. Meet Tinny, Lucy, Katrina and Bertha — our four stills."
>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">The Distillery</p>
      <h1>Wine country.<br />Ocean-dark spirits.</h1>
      <p class="muted lede-sub">
        Black Squid Distillery sits in the heart of the Barossa Valley, surrounded by some of the
        world&rsquo;s most famous wineries. We grow Shiraz on our own Klahn Estate vineyards, press it
        in our winery, and distil it on the property — vine to still to bottle, without leaving home.
      </p>
      <div class="stats">
        <div><span class="k">4</span><span class="l">Stills</span></div>
        <div><span class="k">3,550L</span><span class="l">Combined capacity</span></div>
        <div><span class="k">Estate</span><span class="l">Own-grown Shiraz</span></div>
        <div><span class="k">Rainwater</span><span class="l">Pure Barossa</span></div>
      </div>
    </div>
  </header>

  <section class="pad-s">
    <div class="wrap">
      <p class="eyebrow brass">The Stills</p>
      <h2 class="section-h">Four stills, four temperaments.</h2>
      <p class="muted" style="max-width: 56ch; margin-bottom: 48px;">
        Every still has a personality. Ours have names — and opinions.
      </p>
      <div class="stills-grid">
        {stills.map((s) => (
          <article class="still-card reveal">
            <div class="still-photo">
              <StillMark variant={s.variant} />
            </div>
            <p class="eyebrow brass">{s.size} · {s.build}</p>
            <h3>{s.name}</h3>
            <p class="temper">“{s.temperament}”</p>
            <p class="muted snote">{s.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <hr class="divider-ink" />

  <section class="pad">
    <div class="wrap twocol">
      <div>
        <p class="eyebrow">From vine to still</p>
        <h2 class="section-h">The estate behind the squid.</h2>
        <p class="body muted">
          The Klahn Estate vineyards grow the award-winning Shiraz that becomes our signature gins.
          Where most distilleries buy fruit, we walk out the back door for it — which is how a gin
          ends up tasting of raspberries, pepper, dark chocolate and the Barossa itself.
        </p>
        <p class="body muted">
          Bottled with pure Barossa Valley rainwater, finished in small batches, and named after the
          one creature you'd never expect to find this far from the sea.
        </p>
        <p style="margin-top: 28px;"><a class="btn ghost" href="/gins">Taste the result</a> <a class="btn ghost" href="/contract-distilling" style="margin-left: 10px;">Distil with us</a></p>
      </div>
      <div class="estate-photo reveal" role="img" aria-label="Sketch of the Klahn Estate — vine rows in the Barossa Valley, with a squid hiding in the contour lines">
        <svg viewBox="0 0 800 600" fill="none" aria-hidden="true">
          <!-- valley contours, drawn like an ocean chart -->
          <g stroke="rgba(194, 168, 120, 0.34)" stroke-width="1.4">
            <path d="M-10 150 Q160 92 330 128 Q540 172 810 96" />
            <path d="M-10 235 Q190 168 380 206 Q590 248 810 178" opacity="0.85" />
            <path d="M-10 322 Q200 252 410 290 Q620 326 810 266" opacity="0.7" />
            <path d="M-10 412 Q210 344 440 378 Q650 408 810 356" opacity="0.55" />
            <path d="M-10 500 Q230 440 470 468 Q670 490 810 448" opacity="0.4" />
          </g>
          <!-- vine rows on the lower slope -->
          <g stroke="rgba(194, 168, 120, 0.5)" stroke-width="2" stroke-linecap="round">
            <path d="M120 533 l0 -14 M180 528 l0 -16 M240 524 l0 -17 M300 521 l0 -18 M360 519 l0 -18 M420 518 l0 -18 M480 518 l0 -17 M540 520 l0 -16 M600 523 l0 -15 M660 527 l0 -14" />
            <path d="M150 575 l0 -15 M215 571 l0 -17 M280 568 l0 -18 M345 566 l0 -19 M410 565 l0 -19 M475 565 l0 -18 M540 567 l0 -17 M605 570 l0 -16 M670 574 l0 -14" opacity="0.7" />
          </g>
          <!-- the one creature you'd never expect to find this far from the sea -->
          <g transform="translate(560 196) scale(1.9)" stroke="#5d7cf0" opacity="0.62">
            <circle cx="24" cy="24" r="21" stroke-width="1.6" />
            <path d="M14 27c0-6 4.5-10.5 10-10.5S34 21 34 27c0 2.4-1 4-2.6 4-1.4 0-2.2-1-2.2-2.6 0-2.8-2-4.9-5.2-4.9s-5.2 2.1-5.2 4.9c0 1.6-.8 2.6-2.2 2.6C15 31 14 29.4 14 27Z" fill="#5d7cf0" stroke="none" opacity="0.8" />
            <path d="M19 31.5c.2 2-.6 3.8-2.4 5M24 32.5v5.2M29 31.5c-.2 2 .6 3.8 2.4 5" stroke-width="1.4" stroke-linecap="round" />
          </g>
          <text x="62" y="86" fill="rgba(141, 150, 163, 0.75)" font-size="13" letter-spacing="4.5" font-family="ui-monospace, monospace">KLAHN ESTATE · VINE VALE · SA 5352</text>
          <text x="62" y="110" fill="rgba(141, 150, 163, 0.45)" font-size="11" letter-spacing="3" font-family="ui-monospace, monospace">SHIRAZ — BLOCK A · RAINWATER · 4 STILLS</text>
        </svg>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lede-sub { max-width: 62ch; font-size: 1.02rem; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-top: 54px; border-top: 1px solid var(--line); padding-top: 34px; }
  @media (max-width: 720px) { .stats { grid-template-columns: repeat(2, 1fr); } }
  .stats .k { font-family: var(--serif); font-size: 1.9rem; color: var(--brass); display: block; }
  .stats .l { font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); margin-top: 6px; display: block; }

  .stills-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; align-items: start; }
  @media (max-width: 1060px) { .stills-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 580px) { .stills-grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; } }
  .still-card { border: 1px solid var(--line-strong); background: var(--plate); padding: 24px 26px 28px; border-radius: 3px; transition: border-color 0.4s var(--ease), transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .still-card:hover { transform: translateY(-3px); border-color: var(--brass); box-shadow: 0 20px 40px -30px rgba(20, 24, 15, 0.5); }
  .still-photo {
    aspect-ratio: 4 / 3; border-radius: 2px; overflow: hidden; margin-bottom: 22px;
    border: 1px solid var(--line-strong);
    background: radial-gradient(120% 100% at 50% 0%, var(--brine-3), var(--brine));
  }
  .still-photo :global(.still-mark) { transition: transform 0.6s var(--ease); }
  .still-card:hover .still-photo :global(.still-mark) { transform: scale(1.05); }
  .still-card h3 { font-size: 2rem; margin: 8px 0 4px; font-weight: 540; }
  .temper { font-style: italic; color: var(--text); font-family: var(--display); font-size: 1.08rem; margin-bottom: 12px; }
  .snote { font-size: 0.9rem; }
  .estate-photo {
    border: 1px solid var(--line-strong); border-radius: 3px; overflow: hidden;
    aspect-ratio: 4 / 3; background: var(--brine-2);
  }
  .estate-photo svg { width: 100%; height: 100%; display: block; }
</style>
