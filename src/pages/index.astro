---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AddToCart from '../components/AddToCart.jsx';
import ColorChangeGlass from '../components/ColorChangeGlass.astro';
import { fmtPrice } from '../lib/format.js';
import { tileClass } from '../lib/tile.js';

const spirits = (await getCollection('spirits')).sort((a, b) => a.data.order - b.data.order);
const featured = spirits.filter((s) => s.data.featured && !s.data.hidden).slice(0, 3);
const ranges = await getCollection('ranges');
const rangeOf = (slug) => ranges.find((r) => r.id === slug)?.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Distillery',
  name: 'Black Squid Distillery',
  url: 'https://www.blacksquiddistillery.com.au',
  email: 'admin@blacksquiddistillery.com.au',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '960 Light Pass Road',
    addressLocality: 'Vine Vale',
    addressRegion: 'SA',
    postalCode: '5352',
    addressCountry: 'AU',
  },
};
---
<BaseLayout
  title="Black Squid Distillery — Small-batch gin from the Barossa Valley"
  description="Black Squid Distillery turns gin into magic in the heart of the Barossa Valley — from colour-changing Blue Bvjalie to estate-grown Shiraz gin. Witchcraft with pure science."
  jsonLd={jsonLd}
>
  <!-- ============ HERO — the specimen masthead ============ -->
  <section class="hero wrap">
    <div class="masthead">
      <p class="eyebrow cobalt">Specimen 01 · Barossa Valley · 34°S</p>
      <h1>Black Squid</h1>
      <p class="hlede">Gin in the new era — distilled among the world&rsquo;s most famous wineries.</p>
      <p class="htag"><span>Witchcraft,</span> with pure science.</p>

      <div class="hindex" aria-hidden="true">
        <span class="hi-from">indigo</span>
        <span class="litmus-strip"></span>
        <span class="hi-to">blush</span>
      </div>

      <div class="hcta">
        <a class="btn solid" href="/gins">Explore the gins</a>
        <a class="btn ghost" href="#colour">Watch the colour change</a>
      </div>
    </div>

    <figure class="plate brine">
      <canvas id="ink" aria-hidden="true"></canvas>
      <div class="poster" aria-hidden="true"></div>
      <span class="pl tl">Pl. 01 — Coloratura</span>
      <span class="pl tr">34.5°S 138.9°E</span>
      <span class="pl bl">Fig. 1 · ink in water</span>
      <span class="pl br">indigo&nbsp;→&nbsp;blush</span>
      <figcaption class="scroll-hint">scroll — the ink turns</figcaption>
    </figure>
  </section>

  <!-- ============ THE COLOUR CHANGE ============ -->
  <section id="colour" class="pad">
    <div class="wrap twocol">
      <div>
        <p class="eyebrow blush reveal">Phenomenon · pH-triggered</p>
        <h2 class="section-h reveal">Blue, until the tonic hits.</h2>
        <p class="body muted reveal">
          Our Blue Bvjalie Gin steeps in blue butterfly pea flower &mdash; <em>Clitoria ternatea</em> &mdash;
          for seventy-two hours, then is refined with pure Barossa Valley rainwater. Add tonic, lemon or
          lime &mdash; anything of low pH &mdash; and it turns from deep ocean blue to blossom pink, right
          there in the glass.
        </p>
        <div class="measure reveal" style="margin: 26px 0; max-width: 320px;">
          <div class="row"><span class="k">Botanical</span><span class="v">Clitoria ternatea</span></div>
          <div class="row"><span class="k">Steep</span><span class="v">72 hours</span></div>
          <div class="row"><span class="k">Trigger</span><span class="v">pH &lt; 7</span></div>
          <div class="row"><span class="k">Result</span><span class="v">indigo → blush</span></div>
        </div>
        <p class="reveal">
          <a class="btn ghost" href="/gins/klahn-blue-bvjalie-gin-700ml">Meet Blue Bvjalie</a>
        </p>
      </div>
      <div class="reveal">
        <figure class="demo brine">
          <ColorChangeGlass />
          <figcaption>Fig. 2 — anthocyanin shift, observed in glass</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ TWO RANGES ============ -->
  <section class="pad-s">
    <div class="wrap">
      <p class="eyebrow reveal">Index of collections</p>
      <h2 class="section-h reveal">Two ranges. One distillery.</h2>
      <div class="ranges reveal">
        <a class="range-card rc-klahn" href="/gins#klahn">
          <p class="eyebrow brass">Klahn Estate</p>
          <h3>The craft range</h3>
          <p class="muted">
            Named for our own Klahn Estate vineyards &mdash; London Dry, Hemp, the colour-changing
            Blue Bvjalie, and Shiraz gins built on estate fruit.
          </p>
          <span class="range-cta brass-c">Browse Klahn <span class="arr">→</span></span>
        </a>
        <span class="ranges-spine" aria-hidden="true"></span>
        <a class="range-card rc-squid" href="/gins#black-squid">
          <p class="eyebrow cobalt">Black Squid</p>
          <h3>The signature range</h3>
          <p class="muted">
            The namesake: deep, vivid Barossa Shiraz gins &mdash; wine-country fruit pressed in our
            winery and distilled on the property.
          </p>
          <span class="range-cta">Browse Black Squid <span class="arr">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ FEATURED ============ -->
  <section class="pad-s" style="padding-top: 0;">
    <div class="wrap">
      <p class="eyebrow reveal">Currently pouring</p>
      <h2 class="section-h reveal">From the still</h2>
      <div class="grid-3">
        {featured.map((s) => (
          <article class="pcard reveal">
            <a href={`/gins/${s.id}`} class={tileClass('pimg', s.data.images[0])}>
              <img src={s.data.images[0]} alt={s.data.title} loading="lazy" width="300" height="400" />
            </a>
            <p class="pmeta">
              <span class={rangeOf(s.data.range)?.accent === 'brass' ? 'range-k' : 'range-b'}>
                {rangeOf(s.data.range)?.name ?? 'Gin'}
              </span>
              {' '}· {s.data.style} · {s.data.abv}
            </p>
            <h3><a href={`/gins/${s.id}`}>{s.data.title}</a></h3>
            <div class="prow">
              <span class="price" set:html={fmtPrice(s.data.price, s.data.salePrice)} />
              <AddToCart client:visible slug={s.id} title={s.data.title} price={s.data.salePrice ?? s.data.price} soldOut={s.data.soldOut} />
            </div>
          </article>
        ))}
      </div>
      <p class="center reveal" style="margin-top: 44px;">
        <a class="btn ghost" href="/gins">See all the gins</a>
      </p>
    </div>
  </section>

  <hr class="litmus" />

  <!-- ============ THE STILLS TEASER ============ -->
  <section class="pad">
    <div class="wrap twocol">
      <div class="stills-mini reveal" aria-hidden="true">
        <div class="still-dot" style="--h: 30px;"><span>Tinny · 50L</span></div>
        <div class="still-dot" style="--h: 64px;"><span>Lucy · 300L</span></div>
        <div class="still-dot" style="--h: 48px;"><span>Katrina · 200L</span></div>
        <div class="still-dot" style="--h: 120px;"><span>Bertha · 3000L</span></div>
      </div>
      <div>
        <p class="eyebrow reveal">The still-house · four units</p>
        <h2 class="section-h reveal">Tinny, Lucy, Katrina &amp; big Bertha.</h2>
        <p class="body muted reveal">
          Four stills in the heart of the Barossa, each with her own temperament: Tinny the
          50-litre test pilot, Lucy the hard-working beauty, Katrina the full-copper purist &mdash;
          and Bertha, our new 3,000-litre arrival, exactly as big as she sounds.
        </p>
        <p class="reveal" style="margin-top: 26px;">
          <a class="btn ghost" href="/distillery">Meet the stills</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ EXPERIENCES STRIP ============ -->
  <section class="brine exp-strip">
    <div class="wrap center">
      <p class="eyebrow reveal" style="justify-content: center;">By arrangement</p>
      <h2 class="section-h reveal" style="font-size: clamp(1.6rem, 3.5vw, 2.4rem);">The tasting bar opens by arrangement.</h2>
      <p class="muted reveal" style="max-width: 54ch; margin: 0 auto 28px;">
        Our distillery tasting bar isn&rsquo;t open to the public day-to-day &mdash; but private tastings
        can be arranged. Tell us what you&rsquo;re celebrating.
      </p>
      <a class="btn ghost reveal" href="/experiences">Enquire about a tasting</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- hero: specimen masthead + demonstration plate ---------- */
  .hero {
    min-height: 100svh; display: grid; align-items: center;
    grid-template-columns: 1.04fr 0.96fr; gap: clamp(34px, 5vw, 76px);
    padding-top: clamp(120px, 16vh, 160px); padding-bottom: clamp(60px, 8vh, 90px);
  }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; min-height: 0; gap: 38px; } }

  .masthead h1 {
    font-size: clamp(3.6rem, 11vw, 8.2rem); line-height: 0.92;
    letter-spacing: -0.02em; margin: 16px 0 20px; font-weight: 560;
  }
  .hlede {
    font-family: var(--display); font-style: italic; font-weight: 420;
    font-size: clamp(1.2rem, 2.3vw, 1.7rem); line-height: 1.32; color: var(--text);
    max-width: 24ch;
  }
  .htag {
    font-family: var(--mono); font-size: 0.8rem; letter-spacing: 0.08em;
    color: var(--muted); margin-top: 14px; text-transform: lowercase;
  }
  .htag span { color: var(--blush-ink); }

  .hindex { display: flex; align-items: center; gap: 12px; margin: 30px 0 30px; max-width: 380px; }
  .hindex .litmus-strip { flex: 1; }
  .hi-from, .hi-to { font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .hi-from { color: var(--cobalt); }
  .hi-to { color: var(--blush-ink); }

  .hcta { display: flex; flex-wrap: wrap; gap: 12px; }

  /* the dark demonstration plate (the ink lives here, framed — not full-bleed) */
  .plate {
    position: relative; aspect-ratio: 5 / 6; border-radius: 4px; overflow: hidden;
    box-shadow: 0 40px 80px -50px rgba(10, 20, 19, 0.7);
  }
  @media (max-width: 900px) { .plate { aspect-ratio: 4 / 3; } }
  .plate canvas, .plate .poster { position: absolute; inset: 0; width: 100%; height: 100%; }
  .plate .poster {
    background:
      radial-gradient(85% 70% at 70% 22%, rgba(70, 96, 220, 0.30), transparent 60%),
      radial-gradient(80% 60% at 28% 84%, rgba(207, 102, 153, 0.18), transparent 56%),
      radial-gradient(130% 110% at 50% 40%, #0d1726 0%, var(--brine) 72%);
    z-index: -1;
  }
  .plate canvas { opacity: 0; transition: opacity 1.4s ease; }
  .plate .pl {
    position: absolute; font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--bone); opacity: 0.78; z-index: 2;
  }
  .plate .tl { top: 16px; left: 18px; }
  .plate .tr { top: 16px; right: 18px; }
  .plate .bl { bottom: 16px; left: 18px; }
  .plate .br { bottom: 16px; right: 18px; color: var(--blush); opacity: 0.9; }
  .scroll-hint {
    position: absolute; left: 50%; bottom: 42px; transform: translateX(-50%); z-index: 2;
    font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--bone); opacity: 0.62;
  }

  /* one orchestrated load: the masthead surfaces in order */
  @keyframes surface { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .masthead > * { opacity: 0; animation: surface 0.9s var(--ease) forwards; }
  .masthead .eyebrow { animation-delay: 0.05s; }
  .masthead h1 { animation-delay: 0.18s; }
  .masthead .hlede { animation-delay: 0.5s; }
  .masthead .htag { animation-delay: 0.66s; }
  .masthead .hindex { animation-delay: 0.8s; }
  .masthead .hcta { animation-delay: 0.94s; }
  @media (prefers-reduced-motion: reduce) {
    .masthead > * { animation: none; opacity: 1; }
    .plate canvas { display: none; }
  }

  /* ---------- colour-change demonstration ---------- */
  .demo {
    border-radius: 4px; padding: 30px 24px 18px;
    display: flex; flex-direction: column; align-items: center; gap: 16px;
    box-shadow: 0 36px 70px -48px rgba(10, 20, 19, 0.6);
  }
  .demo figcaption {
    font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--muted); text-align: center;
  }

  /* ---------- two ranges on the litmus spine ---------- */
  .ranges { display: grid; grid-template-columns: 1fr auto 1fr; gap: clamp(20px, 3vw, 40px); margin-top: 34px; align-items: stretch; }
  @media (max-width: 840px) { .ranges { grid-template-columns: 1fr; } .ranges-spine { display: none; } }
  .ranges-spine { width: 2px; background: var(--litmus); border-radius: 2px; opacity: 0.85; }
  .range-card {
    border: 1px solid var(--line-strong); background: var(--plate); padding: 34px 32px; border-radius: 3px;
    transition: border-color 0.4s var(--ease), transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
  }
  .range-card:hover { transform: translateY(-3px); box-shadow: 0 22px 44px -32px rgba(20, 24, 15, 0.5); }
  .rc-klahn:hover { border-color: var(--brass); }
  .rc-squid:hover { border-color: var(--cobalt); }
  .range-card h3 { font-size: 1.8rem; margin: 14px 0 12px; font-weight: 500; }
  .range-card .muted { font-size: 0.95rem; }
  .range-cta { display: inline-block; margin-top: 22px; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--cobalt); }
  .range-cta.brass-c { color: var(--brass); }
  .range-cta .arr { display: inline-block; transition: transform 0.4s var(--ease); }
  .range-card:hover .arr { transform: translateX(6px); }

  /* ---------- stills mini chart ---------- */
  .stills-mini { display: flex; align-items: flex-end; justify-content: center; gap: clamp(20px, 4vw, 44px); min-height: 220px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .still-dot { display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .still-dot::before {
    content: ''; width: clamp(44px, 6vw, 64px); height: var(--h);
    background: linear-gradient(to bottom, #c89f5e, #8a6a32);
    border: 1px solid var(--brass); border-radius: 50% 50% 6px 6px / 38% 38% 6px 6px;
  }
  .still-dot span { font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brass); }

  /* ---------- experiences brine strip ---------- */
  .exp-strip { padding: clamp(56px, 8vh, 96px) 0; border-top: 2px solid transparent; border-image: var(--litmus) 1; }
</style>

<script>
  import { initInkHero } from '../scripts/ink-hero.js';
  initInkHero('ink');
</script>
