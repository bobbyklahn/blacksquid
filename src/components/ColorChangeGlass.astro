---
/**
 * ColorChangeGlass — the Blue Bvjalie party trick, rendered.
 * A single glass: tonic pours in, and the deep-ocean blue blooms organically
 * into blossom pink (SVG turbulence displaces a growing radial mask, so the
 * colour front breaks into tendrils like real butterfly-pea chemistry).
 * Auto-plays once on scroll-in; hover/tap to replay. No dependencies.
 */
---

<div class="ccg" data-ccg role="img" aria-label="A glass of Blue Bvjalie gin turning from deep blue to blossom pink as tonic is poured in.">
  <div class="ccg-stage">
    <!-- caustic light pooled on the bar beneath the glass -->
    <span class="ccg-pool ccg-pool-blue"></span>
    <span class="ccg-pool ccg-pool-pink"></span>

    <!-- the tonic stream -->
    <span class="ccg-pour"></span>

    <div class="ccg-glass">
      <div class="ccg-liquid">
        <span class="ccg-blue"></span>
        <span class="ccg-bloom-wrap"><span class="ccg-bloom"></span></span>
        <span class="ccg-surface"></span>
        <span class="ccg-splash"></span>
        <span class="ccg-bubbles">
          <i style="--x:24%;--dly:.45s;--sz:5px;--dur:1.7s"></i>
          <i style="--x:38%;--dly:.9s;--sz:3px;--dur:2.1s"></i>
          <i style="--x:52%;--dly:.6s;--sz:6px;--dur:1.9s"></i>
          <i style="--x:64%;--dly:1.15s;--sz:3px;--dur:2.3s"></i>
          <i style="--x:72%;--dly:.8s;--sz:4px;--dur:2s"></i>
          <i style="--x:46%;--dly:1.4s;--sz:4px;--dur:2.2s"></i>
        </span>
      </div>
      <span class="ccg-shine"></span>
      <span class="ccg-rim"></span>
    </div>

    <p class="ccg-tag" aria-hidden="true"><span class="ccg-plus">+</span> tonic</p>
  </div>

  <p class="ccg-cap" aria-hidden="true">
    <b class="from">deep ocean blue</b><span class="to">↳</span><b class="dest">blossom pink</b>
  </p>

  <!-- organic-edge filter: fractal noise displaces the colour front into tendrils -->
  <svg class="ccg-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="ccgTurb" x="-25%" y="-25%" width="150%" height="150%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.013 0.02" numOctaves="2" seed="7" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="13" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
</div>

<style>
  .ccg {
    display: flex; flex-direction: column; align-items: center; gap: 22px;
    --blue-1: #5a72d8; --blue-2: #3a4cae; --blue-3: #222e83;
    --pink-1: #f0a6cb; --pink-2: #cf6f9c; --pink-3: #a8557e;
    --t: cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ccg-stage {
    position: relative;
    width: clamp(150px, 19vw, 220px);
    aspect-ratio: 3 / 4.1;
    display: flex; align-items: flex-end; justify-content: center;
  }

  /* ---- caustic pools of light under the glass ---- */
  .ccg-pool {
    position: absolute; left: 50%; bottom: -10%; translate: -50% 0;
    width: 150%; height: 38%; border-radius: 50%;
    filter: blur(26px); pointer-events: none; transition: opacity 1.3s var(--t);
  }
  .ccg-pool-blue { background: radial-gradient(50% 50% at 50% 50%, rgba(93,124,240,0.6), transparent 70%); opacity: 0.85; }
  .ccg-pool-pink { background: radial-gradient(50% 50% at 50% 50%, rgba(224,140,180,0.6), transparent 70%); opacity: 0; }

  /* ---- the glass vessel ---- */
  .ccg-glass {
    position: absolute; inset: 6% 6% 0 6%;
    border-radius: 10px 10px 46px 46px / 12px 12px 64px 64px;
    border: 1px solid rgba(236,237,234,0.22);
    border-top-color: rgba(236,237,234,0.4);
    background: linear-gradient(100deg, rgba(236,237,234,0.05), transparent 26% 74%, rgba(236,237,234,0.09));
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), inset 0 -22px 40px -28px rgba(0,0,0,0.6);
  }
  /* liquid sits inside the walls, with a settled surface line near the top */
  .ccg-liquid { position: absolute; inset: 20% 4% 3% 4%; border-radius: 4px 4px 40px 40px / 4px 4px 56px 56px; overflow: hidden; }

  .ccg-blue, .ccg-bloom {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 26px at 50% 0%, rgba(255,255,255,0.4), transparent 62%),
      radial-gradient(90% 70% at 50% 118%, var(--blue-3), transparent 72%),
      linear-gradient(176deg, var(--blue-1), var(--blue-2) 64%, var(--blue-3));
  }
  .ccg-bloom {
    background:
      radial-gradient(120% 26px at 50% 0%, rgba(255,255,255,0.5), transparent 62%),
      radial-gradient(90% 70% at 50% 118%, var(--pink-3), transparent 72%),
      linear-gradient(176deg, var(--pink-1), var(--pink-2) 62%, var(--pink-3));
    /* revealed by a soft radial mask that grows from the point of impact */
    -webkit-mask: radial-gradient(circle at 50% 7%, #000 0 36%, rgba(0,0,0,0.45) 52%, transparent 67%) no-repeat 50% 7% / 0% 0%;
    mask: radial-gradient(circle at 50% 7%, #000 0 36%, rgba(0,0,0,0.45) 52%, transparent 67%) no-repeat 50% 7% / 0% 0%;
  }
  /* turbulence displaces the masked front → organic tendrils, not a clean circle.
     The wrap overhangs the liquid walls (negative inset) so displacement can never
     expose the blue base at the edges; the liquid's overflow:hidden clips it clean. */
  .ccg-bloom-wrap { position: absolute; inset: -9%; filter: url(#ccgTurb); }

  /* lit meniscus at the liquid surface */
  .ccg-surface {
    position: absolute; top: 0; left: 0; right: 0; height: 12px;
    background: radial-gradient(80% 100% at 50% 0%, rgba(255,255,255,0.55), rgba(255,255,255,0) 75%);
    opacity: 0.7;
  }
  /* ripple ring where the tonic strikes */
  .ccg-splash {
    position: absolute; top: -3px; left: 50%; translate: -50% 0;
    width: 30%; aspect-ratio: 1; border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.6); opacity: 0;
  }

  .ccg-bubbles { position: absolute; inset: 0; }
  .ccg-bubbles i {
    position: absolute; bottom: 4%; left: var(--x);
    width: var(--sz); height: var(--sz); border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(255,255,255,0.95), rgba(255,255,255,0.25) 70%, transparent);
    opacity: 0;
  }

  /* glass highlights */
  .ccg-shine {
    position: absolute; top: 5%; left: 13%; width: 8%; height: 78%;
    border-radius: 99px; background: linear-gradient(to bottom, rgba(255,255,255,0.42), rgba(255,255,255,0.04) 65%, transparent);
    pointer-events: none;
  }
  .ccg-rim {
    position: absolute; top: 18.5%; left: 4%; right: 4%; height: 14px;
    border-radius: 50%; background: linear-gradient(rgba(255,255,255,0.16), transparent);
    border-top: 1px solid rgba(255,255,255,0.28); pointer-events: none;
  }

  /* the tonic stream */
  .ccg-pour {
    position: absolute; top: -6%; left: 50%; translate: -50% 0; transform-origin: top;
    width: 4px; height: 30%;
    background: linear-gradient(to bottom, rgba(255,255,255,0) , rgba(214,232,255,0.85) 40%, rgba(255,255,255,0.95));
    border-radius: 2px; scale: 1 0; opacity: 0;
    filter: blur(0.4px);
  }

  /* floating caption tag */
  .ccg-tag {
    position: absolute; top: 4%; right: -6%;
    font-size: 0.62rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--paper);
    background: rgba(12,16,22,0.7); border: 1px solid rgba(236,237,234,0.18);
    padding: 6px 10px; border-radius: 99px; backdrop-filter: blur(4px);
    opacity: 0; translate: 0 6px; pointer-events: none;
  }
  .ccg-plus { color: var(--squid); }

  /* the spelled-out caption under the glass */
  .ccg-cap {
    display: flex; align-items: center; gap: 12px;
    font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase;
  }
  .ccg-cap b { font-weight: 500; transition: color 1.1s var(--t), opacity 1.1s var(--t); }
  .ccg-cap .from { color: var(--squid); }
  .ccg-cap .dest { color: var(--muted); opacity: 0.5; }
  .ccg-cap .to { color: var(--muted); opacity: 0.5; }

  .ccg-defs { position: absolute; width: 0; height: 0; pointer-events: none; }

  /* ===================== THE SEQUENCE (gated by .run) ===================== */
  .ccg.run .ccg-pour { animation: ccg-pour 1.5s var(--t) forwards; }
  .ccg.run .ccg-splash { animation: ccg-splash 0.9s ease-out 0.55s; }
  .ccg.run .ccg-bloom { animation: ccg-bloom 2.5s var(--t) 0.45s forwards; }
  .ccg.run .ccg-pool-blue { animation: ccg-fade-out 2.2s var(--t) 0.6s forwards; }
  .ccg.run .ccg-pool-pink { animation: ccg-fade-in 2.2s var(--t) 0.6s forwards; }
  .ccg.run .ccg-surface { animation: ccg-surface 2.6s var(--t) 0.5s forwards; }
  .ccg.run .ccg-tag { animation: ccg-tag 2.4s var(--t) forwards; }
  .ccg.run .ccg-bubbles i { animation: ccg-bubble var(--dur) ease-in var(--dly) 1; }
  .ccg.run .ccg-cap .from { animation: ccg-cap-dim 1.2s var(--t) 1.3s forwards; }
  .ccg.run .ccg-cap .to { animation: ccg-cap-lit 1.2s var(--t) 1.3s forwards; }
  .ccg.run .ccg-cap .dest { animation: ccg-cap-lit 1.2s var(--t) 1.6s forwards; }

  @keyframes ccg-pour {
    0% { scale: 1 0; opacity: 0; }
    12% { opacity: 1; }
    34% { scale: 1 1; opacity: 1; }
    60% { scale: 1 1; opacity: 0.9; }
    100% { scale: 1 1; opacity: 0; }
  }
  @keyframes ccg-splash {
    0% { opacity: 0; scale: 0.2; }
    35% { opacity: 0.8; }
    100% { opacity: 0; scale: 1.5; }
  }
  @keyframes ccg-bloom {
    0% { -webkit-mask-size: 0% 0%; mask-size: 0% 0%; }
    100% { -webkit-mask-size: 380% 380%; mask-size: 380% 380%; }
  }
  @keyframes ccg-surface {
    0%, 100% { opacity: 0.7; }
    20% { opacity: 1; transform: scaleY(1.6); }
    45% { opacity: 0.85; transform: scaleY(0.9); }
  }
  @keyframes ccg-bubble {
    0% { opacity: 0; transform: translateY(0) translateX(0); }
    15% { opacity: 0.9; }
    80% { opacity: 0.6; }
    100% { opacity: 0; transform: translateY(-180px) translateX(6px); }
  }
  @keyframes ccg-tag {
    0%, 8% { opacity: 0; translate: 0 6px; }
    18%, 52% { opacity: 1; translate: 0 0; }
    72%, 100% { opacity: 0; translate: 0 -4px; }
  }
  @keyframes ccg-fade-in { to { opacity: 0.9; } }
  @keyframes ccg-fade-out { to { opacity: 0; } }
  @keyframes ccg-cap-dim { to { color: var(--muted); opacity: 0.5; } }
  @keyframes ccg-cap-lit { to { color: var(--blush, #e08cb4); opacity: 1; } }

  /* settled end-state persists via forwards; nothing to do here */

  @media (prefers-reduced-motion: reduce) {
    /* no pour, no churn — just show the finished blossom-pink result */
    .ccg-pour, .ccg-splash, .ccg-bubbles, .ccg-tag { display: none; }
    .ccg-bloom { -webkit-mask-size: 380% 380%; mask-size: 380% 380%; }
    .ccg-pool-blue { opacity: 0; }
    .ccg-pool-pink { opacity: 0.9; }
    .ccg-cap .from { color: var(--muted); opacity: 0.5; }
    .ccg-cap .to, .ccg-cap .dest { color: #e08cb4; opacity: 1; }
    .ccg * { animation: none !important; }
  }
</style>

<script>
  // Auto-play once when it scrolls into view; replay on hover/tap.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('[data-ccg]').forEach((el) => {
    const play = () => {
      if (reduce) return;
      el.classList.remove('run');
      void el.offsetWidth; // force reflow so the animation restarts cleanly
      el.classList.add('run');
    };
    if (!reduce) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { play(); io.disconnect(); } }),
        { threshold: 0.45 }
      );
      io.observe(el);
      el.addEventListener('pointerenter', play);
      el.addEventListener('click', play);
    }
  });
</script>
